graph G { layout=neato; overlap=false; splines=true; fontname="Liberation Sans"; node [fontname="Liberation Sans", fontsize=9, shape=plaintext]; edge [color="#555555", len=2.1];
 fact [pos="0,0!", label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#d9822b"><font color="white"><b>dw.fact_sales</b></font></td></tr><tr><td align="left">PK sales_key</td></tr><tr><td align="left">order_id, order_item_id (DD)</td></tr><tr><td align="left">FK date_key</td></tr><tr><td align="left">FK customer_key</td></tr><tr><td align="left">FK product_key</td></tr><tr><td align="left">FK seller_key</td></tr><tr><td align="left">FK status_key</td></tr><tr><td align="left">payment_type, installments</td></tr><tr><td align="left"><i>price, freight_value, item_total</i></td></tr><tr><td align="left"><i>delivery_days, delay_days, is_late</i></td></tr><tr><td align="left"><i>review_score</i></td></tr></table>>];
 dd [pos="-3.3,1.7!", label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3b73"><font color="white"><b>dw.dim_date</b></font></td></tr><tr><td align="left">PK date_key (YYYYMMDD)</td></tr><tr><td align="left">full_date, day_of_month</td></tr><tr><td align="left">month, month_name, quarter, year</td></tr><tr><td align="left">day_of_week, is_weekend</td></tr></table>>];
 dc [pos="3.3,1.7!", label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3b73"><font color="white"><b>dw.dim_customer</b></font></td></tr><tr><td align="left">PK customer_key</td></tr><tr><td align="left">customer_unique_id (NK)</td></tr><tr><td align="left">city, state, zip_prefix</td></tr><tr><td align="left">first_purchase_date</td></tr></table>>];
 dp [pos="-3.3,-1.7!", label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3b73"><font color="white"><b>dw.dim_product</b></font></td></tr><tr><td align="left">PK product_key</td></tr><tr><td align="left">product_id (NK)</td></tr><tr><td align="left">category_pt, category_en</td></tr><tr><td align="left">weight_g, volume_cm3</td></tr><tr><td align="left">photos_qty, description_len</td></tr></table>>];
 ds [pos="3.3,-1.7!", label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3b73"><font color="white"><b>dw.dim_seller</b></font></td></tr><tr><td align="left">PK seller_key</td></tr><tr><td align="left">seller_id (NK)</td></tr><tr><td align="left">city, state</td></tr></table>>];
 dst [pos="0,-2.6!", label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3b73"><font color="white"><b>dw.dim_order_status</b></font></td></tr><tr><td align="left">PK status_key</td></tr><tr><td align="left">status_name, is_revenue</td></tr></table>>];
 fact--dd; fact--dc; fact--dp; fact--ds; fact--dst;
}
