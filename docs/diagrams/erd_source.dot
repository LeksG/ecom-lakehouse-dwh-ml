digraph G { rankdir=LR; fontname="Liberation Sans"; node [fontname="Liberation Sans", fontsize=9, shape=plaintext]; edge [fontname="Liberation Sans", fontsize=8, arrowhead=crow, arrowtail=tee, dir=both, color="#555555"];
 customers [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3b73"><font color="white"><b>customers</b></font></td></tr><tr><td align="left">PK customer_id</td></tr><tr><td align="left">customer_unique_id</td></tr><tr><td align="left">zip_code_prefix, city, state</td></tr></table>>];
 orders [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3b73"><font color="white"><b>orders</b></font></td></tr><tr><td align="left">PK order_id</td></tr><tr><td align="left">FK customer_id</td></tr><tr><td align="left">order_status</td></tr><tr><td align="left">purchase_timestamp, approved_at</td></tr><tr><td align="left">delivered_carrier/customer_date</td></tr><tr><td align="left">estimated_delivery_date</td></tr></table>>];
 items [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3b73"><font color="white"><b>order_items</b></font></td></tr><tr><td align="left">PK,FK order_id</td></tr><tr><td align="left">PK order_item_id</td></tr><tr><td align="left">FK product_id, FK seller_id</td></tr><tr><td align="left">shipping_limit_date</td></tr><tr><td align="left">price, freight_value</td></tr></table>>];
 payments [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3b73"><font color="white"><b>order_payments</b></font></td></tr><tr><td align="left">PK,FK order_id</td></tr><tr><td align="left">PK payment_sequential</td></tr><tr><td align="left">payment_type, installments, value</td></tr></table>>];
 reviews [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3b73"><font color="white"><b>order_reviews</b></font></td></tr><tr><td align="left">PK review_id</td></tr><tr><td align="left">FK order_id</td></tr><tr><td align="left">review_score, comment</td></tr><tr><td align="left">creation_date, answer_timestamp</td></tr></table>>];
 products [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3b73"><font color="white"><b>products</b></font></td></tr><tr><td align="left">PK product_id</td></tr><tr><td align="left">FK category_name</td></tr><tr><td align="left">name/description length, photos_qty</td></tr><tr><td align="left">weight_g, length/height/width_cm</td></tr></table>>];
 sellers [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3b73"><font color="white"><b>sellers</b></font></td></tr><tr><td align="left">PK seller_id</td></tr><tr><td align="left">zip_code_prefix, city, state</td></tr></table>>];
 cat [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3b73"><font color="white"><b>category_translation</b></font></td></tr><tr><td align="left">PK category_name</td></tr><tr><td align="left">category_name_english</td></tr></table>>];
 customers->orders; orders->items; orders->payments; orders->reviews; products->items; sellers->items; cat->products;
}
